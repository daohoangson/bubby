{
  "name": "bubby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "eve dev --no-default-extensions --host 127.0.0.1",
    "build": "eve build",
    "start": "eve start",
    "info": "eve info",
    "deploy": "eve deploy",
    "test": "node --test 'lib/**/*.test.ts' 'agent/**/*.test.ts'",
    "dev:server": "eve dev --no-ui --no-default-extensions --host 127.0.0.1",
    "telegram:webhook": "node --env-file=.env.local scripts/telegram-webhook.mjs",
    "typecheck": "tsc --noEmit",
    "secrets:aws": "node scripts/aws-secrets.mjs",
    "test:webhook": "node --env-file=.env.local scripts/smoke-webhook.mjs",
    "test:model": "node scripts/smoke-model.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "ai": "^7.0.137",
    "eve": "0.77.0",
    "just-bash": "^3.6.0",
    "zod": "4.5.4"
  },
  "packageManager": "pnpm@8.15.9",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
