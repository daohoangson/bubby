# Optional native Vercel AI Gateway model; takes precedence over OPENAI_*.
AI_GATEWAY_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible API root, including /v1. Leave empty for OpenAI.
OPENAI_BASE_URL=
# responses or chat (Chat Completions).
OPENAI_API=responses
# Supermemory account key for automatic cross-topic personal memory.
SUPERMEMORY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=bubby2023_bot
# Comma-separated Telegram user IDs permitted in private chats.
TELEGRAM_ALLOWED_USER_IDS=
# Explicitly approved group/supergroup chat IDs; empty disables group access.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional Zalo Bot channel. Empty allowlists disable access.
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET_TOKEN=
ZALO_ALLOWED_USER_IDS=
ZALO_ALLOWED_CHAT_IDS=
EVE_TELEMETRY_DISABLED=1
EVE_TRACES_CONTENT=off
